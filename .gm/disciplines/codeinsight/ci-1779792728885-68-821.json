function computeWeakest(rows) {
    if (!rows.length) return null;
    const scored = rows.map(r => {
        const masteryFloor = r.scheduled === 0 ? 0 : r.mastery;
        const composite = masteryFloor + r.trend * 25;
        return { ...r, composite };
    }).sort((a, b) => a.composite - b.composite);
    return scored[0];
}