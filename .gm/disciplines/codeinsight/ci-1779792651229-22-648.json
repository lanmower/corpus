function fillSubjectMaps(cfg) {
    const w = { ...cfg.weights };
    const en = { ...cfg.enabled };
    for (const s of SUBJECTS) {
        if (w[s] == null) w[s] = 1;
        if (en[s] == null) en[s] = true;
    }
    return { ...cfg, weights: w, enabled: en };
}