function main() {
    const allGuids = new Map();
    let totalNotes = 0, totalFiles = 0, totalSkipped = 0;
    const dupes = [];
    for (const s of SUBJECTS) {
        const dir = path.join(ROOT, s, 'srs-cards');
        const files = fs.readdirSync(dir).filter(f => /\.ya?ml$/.test(f));
        for (const f of files) {
            const r = migrateOne(s, f);
            totalFiles++;
            totalNotes += r.count;
            totalSkipped += r.skipped;
            for (const n of r.notes) {
                if (allGuids.has(n.guid)) dupes.push({ guid: n.guid, a: allGuids.get(n.guid), b: `${s}/${f}` });
                else allGuids.set(n.guid, `${s}/${f}`);
            }
            console.log(`${s}/${f}: ${r.count} notes (${r.skipped} skipped)`);
        }
    }
    console.log(`\nTotal: ${totalNotes} notes across ${totalFiles} files (${totalSkipped} skipped, ${dupes.length} guid collisions)`);
    if (dupes.length) console.log('Duplicates:', dupes.slice(0, 10));
}