e => {
    if (e.request.method !== 'GET') return;
    let url;
    try { url = new URL(e.request.url); } catch { return; }
    if (url.origin !== location.origin) return;

    e.respondWith(handle(e.request).catch(() => new Response('sw-error', { status: 503, statusText: 'sw-error' })));
}