./site/tutor-panel.js:326:334 regenerateLast
function regenerateLast() {
    if (isThinking || !lastUserText) return;
    // Drop the trailing assistant turn (if any) then re-send the last user text.
    if (tutorMessages.length && tutorMessages[tutorMessages.length - 1].role === 'assistant') {
        tutorMessages.pop();
    }
    persist();
    sendTutorMessage(lastUserText, { isRegenerate: true });
}