function yamlEscape(s) {
    if (s == null) return '""';
    const str = String(s);
    if (str.includes('\n')) {
        const indent = '      ';
        return '|\n' + str.split('\n').map(l => indent + l).join('\n');
    }
    return JSON.stringify(str);
}