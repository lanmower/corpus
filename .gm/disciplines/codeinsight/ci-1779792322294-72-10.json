function migrateOne(subject, file) {
    const fp = path.join(ROOT, subject, 'srs-cards', file);
    const text = fs.readFileSync(fp, 'utf8');
    const raw = readCardsFromYml(text, file);
    const topic = topicFromFilename(file);
    const subjCap = subject[0].toUpperCase() + subject.slice(1);
    const deck = `Corpus::${subjCap}::${topic}`;
    const notes = [];
    let skipped = 0;
    for (const c of raw) {
        if (!c) { skipped++; continue; }
        const front = String(c.front || c.Front || '').trim();
        const back = String(c.back || c.Back || '').trim();
        if (!front) { skipped++; continue; }
        const tags = [];
        const inTags = Array.isArray(c.tags) ? c.tags : [];
        for (const t of inTags) if (t != null && String(t).trim()) tags.push(String(t).trim().replace(/\s+/g, '_'));
        if (c.difficulty) tags.push(`difficulty:${c.difficulty}`);
        if (c.source) tags.push(`source:${String(c.source).replace(/\s+/g, '_')}`);
        tags.push(`subject:${subject}`);
        const isCloze = detectCloze(front) || detectCloze(back);
        const noteType = isCloze ? 'Cloze' : 'Basic';
        const guid = c._guid || guidFor(subject, front, back);
        const fields = isCloze
            ? { Text: front, Extra: back }
            : { Front: front, Back: back };
        notes.push({ guid, noteType, deck: c._deck || deck, fields, tags });
    }
    const header = [
        `# Anki canonical export — ${subject} / ${topic}`,
        `# Generated by scripts/anki_migrate.js`,
        `deck: ${JSON.stringify(deck)}`,
        `notes:`
    ].join('\n');
    const body = notes.map(emitNote).join('\n');
    fs.writeFileSync(fp, header + '\n' + body + '\n');
    return { count: notes.length, skipped, notes };
}