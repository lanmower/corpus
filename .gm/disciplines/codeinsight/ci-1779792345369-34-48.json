function yamlEscape(s) {
    if (s == null) return '""';
    s = String(s);
    if (/[\n:#&*!|>'"%@`]/.test(s) || s.includes('  ')) {
        // use double-quoted with escapes
        return '"' + s.replace(/\\/g, '\\\\').replace(/"/g, '\\"').replace(/\n/g, '\\n') + '"';
    }
    return s;
}