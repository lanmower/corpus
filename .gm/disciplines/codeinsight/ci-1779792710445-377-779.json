function setStatus(status, detail = '') {
    modelStatus = status;
    modelStatusDetail = detail;
    const pill = panelContainer?.querySelector('#tutor-status-pill');
    if (pill) { pill.textContent = statusLabel(); pill.dataset.status = status; }
    if (sdkRender) sdkRender();
}