function emitNote(n) {
    const lines = [];
    lines.push(`  - guid: ${n.guid}`);
    lines.push(`    noteType: ${n.noteType}`);
    lines.push(`    deck: ${JSON.stringify(n.deck)}`);
    lines.push(`    fields:`);
    if (n.noteType === 'Cloze') {
        lines.push(`      Text: ${yamlEscape(n.fields.Text)}`);
        if (n.fields.Extra) lines.push(`      Extra: ${yamlEscape(n.fields.Extra)}`);
    } else {
        lines.push(`      Front: ${yamlEscape(n.fields.Front)}`);
        lines.push(`      Back: ${yamlEscape(n.fields.Back)}`);
    }
    lines.push(`    tags: [${n.tags.map(t => JSON.stringify(t)).join(', ')}]`);
    return lines.join('\n');
}